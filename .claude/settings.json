{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); p=\"$CLAUDE_PROJECT_DIR/node_modules/.bin/prettier\"; [ -n \"$f\" ] && [ -x \"$p\" ] && \"$p\" --write --ignore-unknown \"$f\" >/dev/null 2>&1; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|WebFetch|WebSearch|mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c \".tool_input\" | grep -qiE \"satnaing/terminal-portfolio\" && { echo \"Blocked: do not read the reference repo (satnaing/terminal-portfolio). Study the live site https://terminal.satnaing.dev/ instead: use it and inspect the page (see CLAUDE.md).\" >&2; exit 2; }; exit 0"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm -s lint)",
      "Bash(pnpm -s spec:status *)",
      "Bash(pnpm -s test)",
      "Bash(pnpm -s typecheck)",
      "Bash(pnpm exec prettier --check *)",
      "Bash(pnpm lint)",
      "Bash(pnpm spec:status *)",
      "Bash(pnpm spec:status)",
      "Bash(pnpm test)",
      "Bash(pnpm typecheck)",
      "mcp__playwright__browser_close",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_resize",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_take_screenshot"
    ]
  }
}
